# Copy to app/.env.local and fill in secrets. Never commit .env.local.
# Public / non-secret values are safe to share; anything marked SECRET is not.

# Required: online PostgreSQL (Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Hedera testnet payment authority (server-side only, never exposed to agents).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.x
HEDERA_OPERATOR_KEY=SECRET_HEX_ECDSA_KEY
# Merchant account receiving scan payments (public account id, NOT secret).
X402_PAY_TO_ACCOUNT=0.0.10482549
# Scanner price in USD cents (default 25).
X402_SCANNER_PRICE_CENTS=25

# Test/dev escape hatches (default 0; never enable for a recorded take).
X402_DEV_BYPASS=0
X402_SIMULATE_FAILURE=0

# Optional integrations.
AGENT0_SUBGRAPH_URL=
GITHUB_TOKEN=
LEDGER_PROVIDER=dev
LEDGER_WALLET_CLI_PATH=
LLM_INTENT_PROVIDER=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cubic-demo
# REQUIRED for trace links (key alone is not enough — the SDK defaults tracing
# OFF and getCurrentRunTree() returns an id-less stub without it).
LANGSMITH_TRACING=true
